{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dosagecalc",
  "main": "./cloudflare/instructor-worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/instructor-api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "INSTRUCTOR_QUIZZES",
      "id": "a651fa8e1e35435c858c8ad2939f08f5"
    }
  ]
}
